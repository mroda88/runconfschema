#!/bin/bash

for FILE in schema/runconfschema/*.proto;
do
    echo "Generating protocols for ${FILE}"

    python -m grpc_tools.protoc \
        --proto_path=./schema/ \
        --python_out=src/ \
        --grpc_python_out=src/ \
        --mypy_out=src/ \
	    --mypy_grpc_out=src/ \
        ${FILE}
done
